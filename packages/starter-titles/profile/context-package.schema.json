{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-engine:profile:context-package:0.1.0",
  "title": "Semantic Engine Context Data Package Profile",
  "description": "Data Package v2 extension for distributable recognition contexts.",
  "allOf": [
    { "$ref": "https://datapackage.org/profiles/2.0/datapackage.json" },
    {
      "type": "object",
      "required": ["$schema", "name", "id", "version", "licenses", "sources", "resources", "semanticEngine"],
      "properties": {
        "$schema": { "const": "profile/context-package.schema.json" },
        "name": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
        "id": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "required": ["name"] }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title"],
            "properties": { "title": { "type": "string", "minLength": 1 } }
          }
        },
        "semanticEngine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formatVersion", "kind", "locales", "spdxLicenseExpression"],
          "properties": {
            "formatVersion": { "const": "0.1.0" },
            "kind": { "const": "recognition-context" },
            "locales": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" }
            },
            "spdxLicenseExpression": { "type": "string", "minLength": 1 }
          }
        },
        "resources": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": ["name", "path", "hash", "bytes", "semanticEngine"],
            "properties": {
              "semanticEngine": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "schema"],
                "properties": {
                  "role": { "const": "targets" },
                  "schema": { "const": "profile/title-resource.schema.json" }
                }
              },
              "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 1 }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ]
}
