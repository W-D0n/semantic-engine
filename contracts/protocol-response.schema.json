{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-engine.dev/contracts/protocol-response.schema.json",
  "title": "Semantic Engine Protocol Response",
  "description": "Exactly one response line for each non-empty request line.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "status"],
  "properties": {
    "protocol_version": { "const": 2 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["ok", "error"] },
    "result": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    {
      "required": ["result"],
      "properties": { "status": { "const": "ok" } },
      "not": { "required": ["error"] }
    },
    {
      "required": ["error"],
      "properties": { "status": { "const": "error" } },
      "not": { "required": ["result"] }
    }
  ]
}
