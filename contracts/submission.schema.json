{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-engine.dev/contracts/submission.schema.json",
  "title": "Semantic Engine Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "participant_id", "source_sequence", "text"],
  "properties": {
    "message_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "participant_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source_sequence": { "type": "integer", "minimum": 0 },
    "text": { "type": "string", "maxLength": 1000 }
  }
}
