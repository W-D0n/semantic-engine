{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-engine:schema:title-resource:0.1.0",
  "title": "Semantic Engine title targets",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "titles"],
  "properties": {
    "version": { "const": 1 },
    "titles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "canonical", "aliases"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-z0-9._-]+$"
          },
          "kind": { "enum": ["movie", "game", "other"] },
          "canonical": { "type": "string", "minLength": 1, "maxLength": 256 },
          "aliases": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  }
}
